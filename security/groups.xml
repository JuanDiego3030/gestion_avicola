<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_veterinario" model="res.groups">
        <field name="name">Avícola / Veterinario</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_veterinario_manager" model="res.groups">
        <field name="name">Avícola / Administrador</field>
        <field name="implied_ids" eval="[Command.link(ref('group_veterinario'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
