<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== GRANJA ======== -->
    <record id="view_avicola_granja_list" model="ir.ui.view">
        <field name="name">avicola.granja.list</field>
        <field name="model">avicola.granja</field>
        <field name="arch" type="xml">
            <list string="Granjas de Engorde">
                <field name="name"/>
                <field name="tipo"/>
                <field name="ubicacion"/>
                <field name="total_galpones"/>
                <field name="total_aves"/>
                <field name="metros_totales"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_granja_form" model="ir.ui.view">
        <field name="name">avicola.granja.form</field>
        <field name="model">avicola.granja</field>
        <field name="arch" type="xml">
            <form string="Granja de Engorde">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre de la Granja"/>
                        <h1><field name="name" placeholder="Ej. Granja Los Pinos"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo" widget="radio"/>
                            <field name="ubicacion"/>
                        </group>
                        <group>
                            <field name="total_galpones" readonly="1"/>
                            <field name="total_aves" readonly="1"/>
                            <field name="metros_totales" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Galpones">
                            <field name="galpon_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="metros_cuadrados"/>
                                    <field name="capacidad_maxima"/>
                                    <field name="cantidad_actual"/>
                                    <field name="densidad_actual" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avicola_granja" model="ir.actions.act_window">
        <field name="name">Granjas de Engorde</field>
        <field name="res_model">avicola.granja</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra tu primera granja de engorde.</p>
        </field>
    </record>


    <!-- ======== GALPON ======== -->
    <record id="view_avicola_galpon_list" model="ir.ui.view">
        <field name="name">avicola.galpon.list</field>
        <field name="model">avicola.galpon</field>
        <field name="arch" type="xml">
            <list string="Galpones">
                <field name="granja_id"/>
                <field name="name"/>
                <field name="metros_cuadrados"/>
                <field name="capacidad_maxima"/>
                <field name="cantidad_actual"/>
                <field name="densidad_actual"/>
                <field name="total_mortalidad"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_galpon_form" model="ir.ui.view">
        <field name="name">avicola.galpon.form</field>
        <field name="model">avicola.galpon</field>
        <field name="arch" type="xml">
            <form string="Galpón">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Identificador del Galpón"/>
                        <h1><field name="name" placeholder="Ej. Galpón 01"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="granja_id"/>
                            <field name="metros_cuadrados"/>
                            <field name="capacidad_maxima"/>
                        </group>
                        <group>
                            <field name="cantidad_actual"/>
                            <field name="densidad_actual" readonly="1"/>
                            <field name="total_mortalidad" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Mortalidad">
                            <field name="mortalidad_ids" readonly="1">
                                <list>
                                    <field name="fecha"/>
                                    <field name="cantidad"/>
                                    <field name="observaciones"/>
                                    <field name="estado" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avicola_galpon_graph" model="ir.ui.view">
        <field name="name">avicola.galpon.graph</field>
        <field name="model">avicola.galpon</field>
        <field name="arch" type="xml">
            <graph string="Aves por Galpón" type="bar">
                <field name="name"/>
                <field name="granja_id"/>
                <field name="cantidad_actual" type="measure"/>
                <field name="densidad_actual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_avicola_galpon_pivot" model="ir.ui.view">
        <field name="name">avicola.galpon.pivot</field>
        <field name="model">avicola.galpon</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de Galpones">
                <field name="granja_id" type="row"/>
                <field name="name" type="row"/>
                <field name="cantidad_actual" type="measure"/>
                <field name="metros_cuadrados" type="measure"/>
                <field name="densidad_actual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_avicola_galpon" model="ir.actions.act_window">
        <field name="name">Galpones</field>
        <field name="res_model">avicola.galpon</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>


    <!-- ======== DISTRIBUCION DE POLLITOS ======== -->
    <record id="view_avicola_distribucion_list" model="ir.ui.view">
        <field name="name">avicola.distribucion.list</field>
        <field name="model">avicola.distribucion</field>
        <field name="arch" type="xml">
            <list string="Distribución de Pollitos" decoration-success="estado == 'confirmado'" decoration-muted="estado == 'borrador'">
                <field name="lote_incubadora"/>
                <field name="fecha"/>
                <field name="granja_id"/>
                <field name="galpon_id"/>
                <field name="cantidad"/>
                <field name="estado" widget="badge" decoration-success="estado == 'confirmado'" decoration-warning="estado == 'borrador'"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_distribucion_form" model="ir.ui.view">
        <field name="name">avicola.distribucion.form</field>
        <field name="model">avicola.distribucion</field>
        <field name="arch" type="xml">
            <form string="Distribución de Pollitos">
                <header>
                    <button name="action_confirmar" string="Confirmar e Ingresar Aves" type="object"
                            class="btn-primary" invisible="estado == 'confirmado'"/>
                    <button name="action_borrador" string="Volver a Borrador" type="object"
                            invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_proyeccion" type="object"
                                class="oe_stat_button" icon="fa-line-chart"
                                invisible="estado != 'confirmado'">
                            <field name="proyeccion_count" widget="statinfo" string="Proyección Saca"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="lote_incubadora"/>
                            <field name="fecha"/>
                        </group>
                        <group>
                            <field name="granja_id"/>
                            <field name="galpon_id" domain="[('granja_id', '=', granja_id)]"/>
                            <field name="cantidad"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avicola_distribucion_graph" model="ir.ui.view">
        <field name="name">avicola.distribucion.graph</field>
        <field name="model">avicola.distribucion</field>
        <field name="arch" type="xml">
            <graph string="Distribuciones por Granja" type="bar">
                <field name="granja_id"/>
                <field name="cantidad" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_avicola_distribucion" model="ir.actions.act_window">
        <field name="name">Distribución de Pollitos</field>
        <field name="res_model">avicola.distribucion</field>
        <field name="view_mode">list,form,graph</field>
    </record>


    <!-- ======== MORTALIDAD ======== -->
    <record id="view_avicola_mortalidad_list" model="ir.ui.view">
        <field name="name">avicola.mortalidad.list</field>
        <field name="model">avicola.mortalidad</field>
        <field name="arch" type="xml">
            <list string="Mortalidad de Aves" decoration-danger="estado == 'confirmado'" decoration-muted="estado == 'borrador'">
                <field name="lote_incubadora"/>
                <field name="fecha"/>
                <field name="granja_id"/>
                <field name="galpon_id"/>
                <field name="cantidad"/>
                <field name="estado" widget="badge" decoration-danger="estado == 'confirmado'" decoration-warning="estado == 'borrador'"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_mortalidad_form" model="ir.ui.view">
        <field name="name">avicola.mortalidad.form</field>
        <field name="model">avicola.mortalidad</field>
        <field name="arch" type="xml">
            <form string="Registro de Mortalidad">
                <header>
                    <button name="action_confirmar" string="Confirmar Mortalidad" type="object"
                            class="btn-primary" invisible="estado == 'confirmado'"/>
                    <button name="action_borrador" string="Volver a Borrador" type="object"
                            invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="lote_incubadora" readonly="1"/>
                            <field name="fecha"/>
                            <field name="granja_id"/>
                        </group>
                        <group>
                            <field name="galpon_id" domain="[('granja_id', '=', granja_id)]"/>
                            <field name="cantidad"/>
                            <field name="observaciones"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_avicola_mortalidad_graph" model="ir.ui.view">
        <field name="name">avicola.mortalidad.graph</field>
        <field name="model">avicola.mortalidad</field>
        <field name="arch" type="xml">
            <graph string="Mortalidad por Granja" type="bar">
                <field name="granja_id"/>
                <field name="cantidad" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_avicola_mortalidad" model="ir.actions.act_window">
        <field name="name">Mortalidad de Aves</field>
        <field name="res_model">avicola.mortalidad</field>
        <field name="view_mode">list,form,graph</field>
    </record>


    <!-- ======== ACCIONES DE SALIDAS / DESPACHOS UNIFICADAS ======== -->
    <record id="action_avicola_salida" model="ir.actions.act_window">
        <field name="name">Despachos a Matadero</field>
        <field name="res_model">avicola.despacho</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ======== DESPACHOS Y SALIDAS A MATADERO (UNIFICADO) ======== -->
    <record id="view_avicola_despacho_list" model="ir.ui.view">
        <field name="name">avicola.despacho.list</field>
        <field name="model">avicola.despacho</field>
        <field name="arch" type="xml">
            <list string="Salidas a Matadero / Despachos" decoration-success="estado == 'confirmado'" decoration-muted="estado == 'borrador'" decoration-danger="estado == 'cancelado'">
                <field name="name"/>
                <field name="fecha"/>
                <field name="granja"/>
                <field name="galpon_id"/>
                <field name="cliente" string="Matadero / Cliente"/>
                <field name="cantidad_aves" string="Aves"/>
                <field name="peso_neto" string="Peso Neto (kg)"/>
                <field name="peso_promedio" string="Peso Prom. (kg)"/>
                <field name="chofer"/>
                <field name="placa"/>
                <field name="estado" widget="badge" decoration-success="estado == 'confirmado'" decoration-warning="estado == 'borrador'" decoration-danger="estado == 'cancelado'"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_despacho_form" model="ir.ui.view">
        <field name="name">avicola.despacho.form</field>
        <field name="model">avicola.despacho</field>
        <field name="arch" type="xml">
            <form string="Salida a Matadero / Despacho">
                <header>
                    <button name="action_confirm_despacho" string="Confirmar Salida a Matadero" type="object"
                            class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="action_print_ticket" string="Imprimir Ticket" type="object"
                            class="btn-secondary" icon="fa-print"/>
                    <button name="action_borrador" string="Volver a Borrador" type="object"
                            invisible="estado != 'confirmado'"/>
                    <button name="action_cancelar" string="Cancelar" type="object"
                            invisible="estado == 'cancelado'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nro de Ticket / Salida"/>
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <notebook>
                        <page string="Datos de Salida / Matadero">
                            <group>
                                <group string="Origen y Destino">
                                    <field name="fecha"/>
                                    <field name="granja"/>
                                    <field name="galpon_id" domain="[('granja_id', '=', granja)]"/>
                                    <field name="cliente" string="Matadero / Cliente"/>
                                    <field name="orden_compra"/>
                                </group>
                                <group string="Pesaje y Cantidades">
                                    <field name="cantidad_aves" string="Aves a Matadero"/>
                                    <field name="cant_jaulas"/>
                                    <field name="pollos_por_jaula"/>
                                    <field name="peso_neto" string="Peso Neto (kg)"/>
                                    <field name="peso_promedio" readonly="1"/>
                                    <field name="pollo_mojado" widget="radio"/>
                                </group>
                            </group>
                            <group string="Transporte y Cuadrilla">
                                <group>
                                    <field name="chofer"/>
                                    <field name="placa"/>
                                    <field name="cuadrilla"/>
                                </group>
                                <group>
                                    <field name="supervisor"/>
                                    <field name="inicio_carga"/>
                                    <field name="final_carga"/>
                                </group>
                            </group>
                            <group string="Precintos de Seguridad">
                                <field name="precinto_1"/>
                                <field name="precinto_2"/>
                                <field name="precinto"/>
                            </group>
                        </page>

                        <page string="Datos de la Empresa">
                            <group>
                                <group string="Empresa Emisora">
                                    <field name="company_name" readonly="1"/>
                                    <field name="company_rif" readonly="1"/>
                                    <field name="company_direccion" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avicola_despacho" model="ir.actions.act_window">
        <field name="name">Salidas a Matadero / Despachos</field>
        <field name="res_model">avicola.despacho</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra una salida o despacho de aves listas para matadero.</p>
        </field>
    </record>


    <!-- ======== VETERINARIOS ======== -->
    <record id="view_avicola_veterinario_list" model="ir.ui.view">
        <field name="name">avicola.veterinario.list</field>
        <field name="model">avicola.veterinario</field>
        <field name="arch" type="xml">
            <list string="Veterinarios">
                <field name="name"/>
                <field name="user_id"/>
                <field name="granja_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_veterinario_form" model="ir.ui.view">
        <field name="name">avicola.veterinario.form</field>
        <field name="model">avicola.veterinario</field>
        <field name="arch" type="xml">
            <form string="Veterinario">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre del Veterinario"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="granja_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avicola_veterinario" model="ir.actions.act_window">
        <field name="name">Veterinarios</field>
        <field name="res_model">avicola.veterinario</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ======== PLANIFICACIONES DE VACUNACION ======== -->
    <record id="view_avicola_plan_vacunacion_list" model="ir.ui.view">
        <field name="name">avicola.plan.vacunacion.list</field>
        <field name="model">avicola.plan.vacunacion</field>
        <field name="arch" type="xml">
            <list string="Planificaciones de Vacunación" decoration-success="state == 'realizado'" decoration-info="state == 'programado'" decoration-muted="state == 'borrador'">
                <field name="name"/>
                <field name="veterinario_id"/>
                <field name="granja_id"/>
                <field name="fecha_planificada"/>
                <field name="state" widget="badge" decoration-success="state == 'realizado'" decoration-info="state == 'programado'" decoration-warning="state == 'borrador'"/>
            </list>
        </field>
    </record>

    <record id="view_avicola_plan_vacunacion_form" model="ir.ui.view">
        <field name="name">avicola.plan.vacunacion.form</field>
        <field name="model">avicola.plan.vacunacion</field>
        <field name="arch" type="xml">
            <form string="Planificación de Vacunación">
                <header>
                    <button name="action_programar" string="Programar" type="object" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_realizar" string="Marcar como Realizado" type="object" class="btn-success"
                            invisible="state == 'realizado'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,programado,realizado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Referencia"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="veterinario_id"/>
                            <field name="granja_id"/>
                            <field name="fecha_planificada"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avicola_plan_vacunacion" model="ir.actions.act_window">
        <field name="name">Planificaciones de Vacunación</field>
        <field name="res_model">avicola.plan.vacunacion</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ======== PANEL DE CONTROL (DASHBOARD) ======== -->
    <record id="view_avicola_dashboard_form" model="ir.ui.view">
        <field name="name">avicola.dashboard.form</field>
        <field name="model">avicola.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard Avícola" create="false" delete="false" class="o_avicola_dashboard_form">
                <sheet style="max-width: 100% !important; width: 100% !important; padding: 0 !important; background: transparent !important; box-shadow: none !important; border: none !important;">
                    <style>
                        .o_avicola_dashboard_form .o_form_sheet_bg {
                            background-color: #f8fafc !important;
                            padding: 20px 24px 0 24px !important;
                        }
                        .o_avicola_dashboard_form .o_form_sheet {
                            background: transparent !important;
                            box-shadow: none !important;
                            border: none !important;
                            max-width: 100% !important;
                        }
                        .avicola-dash-top-bar {
                            background: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 18px;
                            padding: 18px 24px;
                            margin-bottom: 20px;
                            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            flex-wrap: wrap;
                            gap: 16px;
                        }
                        .avicola-filter-pill {
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;
                            background: #f8fafc;
                            border: 1.5px solid #cbd5e1;
                            border-radius: 999px;
                            padding: 6px 16px;
                        }
                        @media (max-width: 991px) {
                            .o_avicola_dashboard_form .o_form_sheet_bg {
                                padding: 12px 8px 0 8px !important;
                            }
                            .avicola-dash-top-bar {
                                padding: 14px 12px !important;
                                flex-direction: column !important;
                                align-items: stretch !important;
                                gap: 14px !important;
                            }
                            .avicola-top-actions {
                                flex-direction: column !important;
                                width: 100% !important;
                                gap: 8px !important;
                            }
                            .avicola-top-actions .btn,
                            .avicola-filter-pill {
                                width: 100% !important;
                                box-sizing: border-box !important;
                            }
                        }
                    </style>

                    <!-- HEADER DEL DASHBOARD CON FILTRO DE GRANJA INTEGRADO -->
                    <div class="avicola-dash-top-bar">
                        <div>
                            <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0 0 4px 0; letter-spacing: -0.5px;">Dashboard</h1>
                            <p style="font-size: 13px; color: #64748b; margin: 0;">Planifica, supervisa y optimiza tus operaciones avícolas con facilidad.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap avicola-top-actions">
                            <div class="avicola-filter-pill">
                                <i class="fa fa-filter text-muted"></i>
                                <span class="fw-bold text-dark small">Granja:</span>
                                <field name="selected_granja_id" options="{'no_create': True, 'no_open': True}" placeholder="Todas las granjas" class="mb-0" style="min-width: 170px;"/>
                            </div>
                            <button name="action_new_despacho" string="+ Nuevo Despacho" type="object" class="btn btn-sm text-white" style="background-color: #144D34; border-radius: 999px; font-weight: 600; padding: 7px 16px; box-shadow: 0 4px 10px rgba(20,77,52,0.2);"/>
                            <button name="action_new_distribucion" string="Distribuir Pollitos" type="object" class="btn btn-sm btn-outline-secondary" style="border-radius: 999px; font-weight: 600; padding: 7px 16px;"/>
                            <button name="action_open_proyecciones" string="Proyecciones Saca" type="object" class="btn btn-sm btn-outline-info" style="border-radius: 999px; font-weight: 600; padding: 7px 16px;"/>
                            <button name="action_open_galpones" string="Ver Galpones" type="object" class="btn btn-sm btn-outline-success" style="border-radius: 999px; font-weight: 600; padding: 7px 16px;"/>
                        </div>
                    </div>

                    <field name="dashboard_html" widget="html" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción Server para abrir el Dashboard siempre con el registro cargado -->
