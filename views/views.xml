dashboard = env['avicola.dashboard'].search([], limit=1)
if not dashboard:
    dashboard = env['avicola.dashboard'].create({'name': 'Panel de Control Avícola'})
action = {
    'type': 'ir.actions.act_window',
    'name': 'Panel de Control Avícola',
    'res_model': 'avicola.dashboard',
    'res_id': dashboard.id,
    'view_mode': 'form',
    'target': 'current',
}
        </field>
    </record>


